# Configuration Firebase, injectée au build.
#
# En local : copier ce fichier en `.env.local` et coller le bloc
# `firebaseConfig` du tableau de bord Firebase, en JSON sur UNE ligne.
#
# En production : la même valeur est stockée comme secret GitHub Actions
# (Settings → Secrets → Actions → VITE_FIREBASE_CONFIG). Elle n'est jamais
# committée. Voir README-FIREBASE.md.

VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
